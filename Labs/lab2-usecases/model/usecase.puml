@startuml usecase
left to right direction
skinparam packageStyle rectangle

actor "Читач" as reader
actor "Бібліотекар" as librarian
actor "Платіжний шлюз" as gateway
actor "Поштовий сервіс" as mail

rectangle "Онлайн-бібліотека з підпискою" {
  usecase "UC-01 Зареєструватися" as UC01
  usecase "UC-02 Підтвердити email" as UC02
  usecase "UC-03 Оформити підписку" as UC03
  usecase "UC-04 Обробити платіж" as UC04
  usecase "UC-05 Позичити книгу" as UC05
  usecase "UC-06 Перевірити підписку і ліміт" as UC06
  usecase "UC-07 Читати книгу" as UC07
  usecase "UC-08 Зберегти прогрес читання" as UC08
  usecase "UC-09 Залишити відгук" as UC09
  usecase "UC-10 Повернути книгу" as UC10
  usecase "UC-11 Модерувати відгуки" as UC11
  usecase "Надіслати сповіщення" as UCNotify
  usecase "Нагадати про повернення" as UC12
}

reader --> UC01
reader --> UC03
reader --> UC05
reader --> UC07
reader --> UC09
reader --> UC10
librarian --> UC11

UC01 ..> UC02 : <<include>>
UC03 ..> UC04 : <<include>>
UC05 ..> UC06 : <<include>>
UC07 ..> UC08 : <<include>>
' нагадування — умовний вкладений крок читання (умова: наближається due_at)
UC12 ..> UC07 : <<extend>>

UC02 --|> UCNotify
UC12 --|> UCNotify

gateway <-- UC04
mail <-- UCNotify
@enduml
