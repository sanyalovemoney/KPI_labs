---
title: Процес життєвого циклу підписки
---
flowchart TD
    subgraph Читач
        S(( )) --> B[Обирає план]
        B --> C[Підтверджує оплату]
    end

    subgraph Система
        C --> D[Створює Payment status=pending]
        D --> E[Надсилає запит на авторизацію]
        E --> F{Результат платежу}
        F -->|так| FK([fork активація ∥ лист — REQ-03])
        FK --> G[Активує Subscription]
        FK --> H[Лист «вітаємо, підписка активна»]
        G --> JN([join обидва кроки виконано])
        H --> JN
        JN --> I[Читач бере книги]
        F -->|ні| C
        I --> J{Прострочено?}
        J -->|ні, повертає в строк| RB[Повертає книгу returned_at=now]
        RB --> UB[Знімає блокування — REQ-08]
        UB --> EX{expires_at > now?}
        EX -->|так| I
        EX -->|ні| END1(( ))
        J -->|так| K[Блокує нові позики REQ-07]
        K --> RB2[Повертає прострочену книгу]
        RB2 --> UB
        I -->|підписка скінчилась і не продовжується| END2(( ))
    end

    subgraph Платіжний шлюз
        E1[Авторизує або відхиляє] --> F
    end

    D -.-> E1
