@startuml components
skinparam componentStyle rectangle

package "Клієнт" {
  [Web UI]
}

package "Backend" {
  [REST API]
  [AuthModule]
  [CatalogModule]
  [SubscriptionModule]
  [PaymentModule]
  [LoanModule]
  [ReviewModule]
  [ProgressModule]

  package "Adapters (зовнішні інтеграції)" {
    [PaymentGatewayAdapter]
    [EmailSenderAdapter]
    [OAuthClientAdapter]
  }

  package "DataAccess (репозиторії)" {
    [UserRepository]
    [BookRepository]
    [SubscriptionRepository]
    [PaymentRepository]
    [LoanRepository]
    [ReviewRepository]
    [ProgressRepository]
  }
  database "Database" as DB
}

' зовнішні системи — актори Lab2 / swimlane Lab4, поза межею
cloud "Payment Gateway" as PG
cloud "Email Service" as MAIL
cloud "OAuth Provider" as OAUTH

' required-порти (абстракції всередині межі)
interface "IPaymentProvider" as IPP
interface "IEmailSender" as IES
interface "IOAuthProvider" as IOA

[Web UI] --> [REST API]
[REST API] --> [AuthModule]
[REST API] --> [CatalogModule]
[REST API] --> [SubscriptionModule]
[REST API] --> [LoanModule]
[REST API] --> [ReviewModule]
[REST API] --> [ProgressModule]

' виклик позики підписки (UC-03 include UC-04, Lab2)
[SubscriptionModule] --> [PaymentModule]

' модулі залежать лише на абстракцію порту, не на конкретний сервіс
[PaymentModule] ..> IPP
[SubscriptionModule] ..> IES
[AuthModule] ..> IES
[LoanModule] ..> IES
[AuthModule] ..> IOA

' адаптери реалізують порт і дивляться на зовнішню систему
[PaymentGatewayAdapter] ..|> IPP
[EmailSenderAdapter] ..|> IES
[OAuthClientAdapter] ..|> IOA
[PaymentGatewayAdapter] --> PG
[EmailSenderAdapter] --> MAIL
[OAuthClientAdapter] --> OAUTH

' один напрямок, як у Lab3: LoanModule питає SubscriptionService
[LoanModule] --> [SubscriptionModule]

[AuthModule] --> [UserRepository]
[CatalogModule] --> [BookRepository]
[SubscriptionModule] --> [SubscriptionRepository]
[PaymentModule] --> [PaymentRepository]
[LoanModule] --> [LoanRepository]
[ReviewModule] --> [ReviewRepository]
[ProgressModule] --> [ProgressRepository]

[UserRepository] --> DB
[BookRepository] --> DB
[SubscriptionRepository] --> DB
[PaymentRepository] --> DB
[LoanRepository] --> DB
[ReviewRepository] --> DB
[ProgressRepository] --> DB
@enduml
